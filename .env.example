# .env.example
# Copy to .env and adjust.  None of these are required – safe defaults
# are baked into config.py.

# FLASK_DEBUG=true
# SECRET_KEY=change-me-in-production
# APP_HOST=0.0.0.0
# APP_PORT=5000

# COMFYUI_BASE_URL=https://your-tunnel.trycloudflare.com
# COMFYUI_TIMEOUT=15
# COMFYUI_CONNECT_TIMEOUT=5
# OBJECT_INFO_CACHE_TTL=300

# ACTIVE_WORKFLOW=anima

# DEFAULT_CHECKPOINT=anima_wai.safetensors
# DEFAULT_VAE=qwen_image_vae.safetensors
# DEFAULT_CLIP=qwen_3_06b_base.safetensors
# DEFAULT_SAMPLER=euler_ancestral
# DEFAULT_SCHEDULER=simple
# DEFAULT_STEPS=20
# DEFAULT_CFG=4.5
# DEFAULT_WIDTH=1152
# DEFAULT_HEIGHT=896
# DEFAULT_BATCH_SIZE=1
# DEFAULT_BATCH_COUNT=1

# DEFAULT_HIRES_SCALE=1.5
# DEFAULT_HIRES_STEPS=12
# DEFAULT_HIRES_CFG=4.0
# DEFAULT_HIRES_SAMPLER=euler_ancestral
